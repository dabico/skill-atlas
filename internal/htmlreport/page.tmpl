<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none';{{if .Skills}} script-src @SCRIPTHASH@;{{end}} style-src 'unsafe-inline'; img-src data:">
<meta name="referrer" content="no-referrer">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<link rel="icon" href="data:,">
<title>Skills in {{.Repo}}</title>
<style>
:root {
  --bg: #ffffff;
  --fg: #1f2328;
  --muted: #59636e;
  --border: #d1d9e0;
  --code-bg: #f6f8fa;
  --link: #0969da;
  --bad-fg: #a40e26;
  --bad-bg: #ffebe9;
  --bad-border: #ff8182;
  color-scheme: light dark;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0d1117;
    --fg: #e6edf3;
    --muted: #9198a1;
    --border: #3d444d;
    --code-bg: #151b23;
    --link: #4493f8;
    --bad-fg: #ffa198;
    --bad-bg: #3c1618;
    --bad-border: #8e3037;
  }
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--fg);
  font: 16px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  overflow-wrap: anywhere;
}
header, main { max-width: 52rem; margin: 0 auto; padding: 0 16px; }
header { padding-top: 24px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }
h1 { margin: 0 0 4px; font-size: 1.5rem; line-height: 1.25; }
h2 { margin: 0 0 4px; font-size: 1.25rem; line-height: 1.3; }
a { color: var(--link); }
code, pre { font: 0.875em/1.45 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
code { background: var(--code-bg); padding: 0.1em 0.35em; border-radius: 4px; }
pre { background: var(--code-bg); padding: 12px; border-radius: 6px; overflow-x: auto; }
pre code { background: none; padding: 0; }
.meta, .counts { margin: 0 0 4px; color: var(--muted); }
.meta code { padding: 0; background: none; }
.counts { font-weight: 600; color: var(--fg); }
.badge {
  display: inline-block;
  padding: 0 6px;
  border: 1px solid var(--bad-border);
  border-radius: 10px;
  background: var(--bad-bg);
  color: var(--bad-fg);
  font-size: 0.75rem;
  font-weight: 600;
  line-height: 1.5;
  vertical-align: middle;
}
nav { padding: 16px 0; border-bottom: 1px solid var(--border); }
nav h2 { font-size: 1rem; color: var(--muted); }
nav ul { margin: 0; padding-left: 1.25rem; }
.skill { padding: 20px 0; border-bottom: 1px solid var(--border); }
.path { margin: 0 0 12px; color: var(--muted); }
.desc { margin: 0 0 12px; white-space: pre-line; }
.fields { margin: 0 0 12px; }
.fields dt { font-size: 0.875rem; color: var(--muted); }
.fields dd { margin: 0 0 6px; white-space: pre-line; }
.fields dd dl { margin: 0; padding-left: 12px; border-left: 2px solid var(--border); }
.errors {
  margin: 0 0 12px;
  padding: 8px 12px;
  border: 1px solid var(--bad-border);
  border-radius: 6px;
  background: var(--bad-bg);
  color: var(--bad-fg);
}
.errors p { margin: 0 0 4px; font-weight: 600; }
.errors ul { margin: 0; padding-left: 1.25rem; }
.body { margin-top: 16px; padding-top: 4px; border-top: 1px solid var(--border); }
.body img { max-width: 100%; }
.body table { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; }
.body th, .body td { padding: 4px 10px; border: 1px solid var(--border); }
.body blockquote { margin-left: 0; padding-left: 12px; border-left: 4px solid var(--border); color: var(--muted); }
.top { display: inline-block; margin-top: 12px; font-size: 0.875rem; }
.empty { padding: 24px 0; color: var(--muted); }
[hidden] { display: none; }
.filter { margin: 0 0 12px; }
.filter input { width: 100%; max-width: 24rem; padding: 6px 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg); color: var(--fg); font: inherit; }
.fcount { margin: 4px 0 0; color: var(--muted); font-size: 0.875rem; }
</style>
</head>
<body>
<header id="top">
<h1>{{.Repo}}</h1>
<p class="meta">{{if .Ref}}@ {{.Ref}}{{end}}{{if .SHA}} (<code title="{{.SHA}}">{{.ShortSHA}}</code>){{end}}</p>
<p class="counts">{{.Summary}}</p>
</header>
<main>
{{- if .Skills}}
<nav id="toc" aria-label="Skills">
<h2>Contents</h2>
<div class="filter" id="filter" hidden>
<input type="search" id="q" placeholder="Filter (press /)" aria-label="Filter skills" autocomplete="off">
<p class="fcount" id="fcount" hidden></p>
</div>
<p class="empty" id="nomatch" hidden>No matching skills</p>
<ul>
{{- range .Skills}}
<li data-match="{{.Match}}"><a href="#{{.ID}}">{{.Name}}</a>{{if .Invalid}} <span class="badge">invalid</span>{{end}}</li>
{{- end}}
</ul>
</nav>
{{- range .Skills}}
<section class="skill" id="{{.ID}}" data-match="{{.Match}}">
<h2>{{.Name}}{{if .Invalid}} <span class="badge">invalid</span>{{end}}</h2>
<p class="path"><code>{{.Path}}</code></p>
{{- if .Description}}
<p class="desc">{{.Description}}</p>
{{- end}}
{{- if .Fields}}
<dl class="fields">
{{- range .Fields}}
<dt>{{.Key}}</dt><dd>{{if .Sub}}<dl>{{range .Sub}}<dt>{{.Key}}</dt><dd>{{.Value}}</dd>{{end}}</dl>{{else}}{{.Value}}{{end}}</dd>
{{- end}}
</dl>
{{- end}}
{{- if .Errors}}
<div class="errors">
<p>Invalid</p>
<ul>
{{- range .Errors}}
<li>{{.}}</li>
{{- end}}
</ul>
</div>
{{- end}}
{{- if .Body}}
<div class="body">
{{.Body}}
</div>
{{- end}}
<a class="top" href="#toc">Back to contents</a>
</section>
{{- end}}
{{- else}}
<p class="empty">{{.Empty}}</p>
{{- end}}
</main>
{{- if .Skills}}
<script>{{.Script}}</script>
{{- end}}
</body>
</html>
